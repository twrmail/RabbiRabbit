 "schemaVersion": 1,
 "what": "The 45 CCEL ThML files (calcom01-calcom45, Calvin's Commentaries, Calvin Translation Society translations) used as the independent witness for our Calvin text.",
 "why": "Every Calvin repair (chapter boundaries, restored text, Hebrew and Greek, word fixes, notes split, verse index) was checked against these files. The files are 74 MB, so they are not stored on main; this manifest records exactly which files they were, so a copy can be re-fetched and proven identical.",
 "howToUse": "Fetch each file from its URL (or take them from the branch below), then check bytes and sha256 against this list before running tools/build-calvin-*.py with CCEL_DIR set to the folder.",
 "copyOfRecord": "git branch ccel-sources-nov2 (staged by Tom, Nov 2 2026)",
 "header": {
  "DC.Rights": "Public Domain",
  "DC.Publisher": "Christian Classics Ethereal Library",
  "printSource": "Baker, 1996 on calcom01 and one other volume; blank on the rest",
  "note": "The ThML header gives no print edition year; the translations are the Calvin Translation Society's 19th-century translations."
 },
